{
  "manifest_version": 2,
  "name": "Mode sombre universel",
  "version": "1.0.0",
  "description": "Force un theme sombre sur tous les sites visites.",
  "author": "Plimb Team",
  "permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dark.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
