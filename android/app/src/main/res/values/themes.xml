<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Plimb" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/plimb_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/plimb_orange</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.Plimb.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="titleTextColor">@color/white</item>
    </style>

    <style name="NavButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <style name="NavButton.Compact">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>
</resources>
