{
  "manifest_version": 2,
  "name": "Mode sombre universel",
  "version": "1.0.0",
  "description": "Force un theme sombre sur tous les sites visites.",
  "author": "Plimb Team",
  "browser_specific_settings": {
    "gecko": {
      "id": "plimb-dark-theme@plimb.browser"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["dark.js"],
      "run_at": "document_start"
    }
  ]
}
